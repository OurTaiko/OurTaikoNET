# What /etc/ourtaiko-net/docker/api.env and storage.env hold on the server. Names only: the
# values are secrets or belong to the server, and are never committed.

# --- api.env
DATABASE_URL=            # ourtaiko_net on the shared PostgreSQL, as the application's role
APP_ORIGIN=https://net.ourtaiko.org
COOKIE_SECURE=true
TRUSTED_PROXY_CIDRS=     # where the reverse proxy reaches the container from

# The account center: one Application for the whole site.
SSO_ISSUER=
SSO_SERVICE_ID=
SSO_SERVICE_KEY=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URL=        # https://net.ourtaiko.org/api/v1/auth/sso/callback
SSO_AVATAR_BASE_URL=
SSO_CONNECT_ADDRESS=     # optional: an internal route to the account center
SESSION_ENCRYPTION_KEY=  # stable across releases

# The old addresses, from the switch on. Leave empty before it.
LEGACY_FANMADE_HOST=     # fanmade.ourtaiko.org
LEGACY_OFFICIAL_HOST=    # database.ourtaiko.org
LEGACY_PROFILE_HOST=     # profile.ourtaiko.org

# --- storage.env
# Before the switch: STORAGE_BACKEND=public with the two prefixes and their public addresses,
# and no bucket and no credentials: the old sites' files are read and cannot be changed
# (deploy/README.md, "Files before the switch"). From the switch on: s3 and all of it.
STORAGE_BACKEND=
S3_BUCKET=               # s3 only
AWS_REGION=              # s3 only
# s3 only: each source signs with its own key, the one its old site used, which is allowed
# that source's prefix and nothing else. (AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY, one key
# for both, are used for a source that has none of its own.)
FANMADE_AWS_ACCESS_KEY_ID=
FANMADE_AWS_SECRET_ACCESS_KEY=
OFFICIAL_AWS_ACCESS_KEY_ID=
OFFICIAL_AWS_SECRET_ACCESS_KEY=
FANMADE_S3_PREFIX=       # the prefix Fanmade's files are under today
FANMADE_S3_PUBLIC_BASE_URL=
OFFICIAL_S3_PREFIX=
OFFICIAL_S3_PUBLIC_BASE_URL=
